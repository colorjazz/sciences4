# ------------------------------------------------------------------
# ATTENTION SÉCURITÉ — même problème identifié sur math4 :
# toute variable préfixée VITE_ est injectée dans le bundle client
# et donc visible par quiconque ouvre les DevTools du navigateur.
# Pour la V1/prototype c'est acceptable, mais avant une mise en
# production réelle, cette clé doit être déplacée derrière un
# gateway serveur (ex. Google Apps Script, Cloudflare Worker,
# Netlify Function) comme discuté pour histoire4, plutôt qu'appelée
# directement depuis le front-end.
# ------------------------------------------------------------------

VITE_GEMINI_API_KEY=your_key_here
VITE_GEMINI_MODEL=gemini-3.6-flash
